{
  "name": "agente-sf",
  "version": "2.0.0",
  "private": true,
  "description": "Chatbot de pruebas para WhatsApp Web con Node.js, whatsapp-web.js y Puppeteer",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "check": "node scripts/checkSyntax.js",
    "test": "node --test",
    "diagnose:browser": "node scripts/checkBrowser.js",
    "reset-session": "node scripts/resetSession.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "dotenv": "16.6.1",
    "puppeteer": "24.38.0",
    "qrcode-terminal": "0.12.0",
    "whatsapp-web.js": "1.34.7"
  }
}
