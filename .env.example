# Puerto del servidor de diagnóstico HTTP
PORT=3000

# Identificador de esta sesión. Use únicamente letras, números, guion o guion bajo.
WWEBJS_CLIENT_ID=agente-sf

# Rutas. Si se omiten, se usa la carpeta data del proyecto.
DATA_DIR=./data
# WWEBJS_AUTH_PATH=./data/whatsapp-auth

# true para ejecutar Chrome sin ventana; false para diagnóstico visual local.
PUPPETEER_HEADLESS=true
# Solo defina esta ruta cuando quiera utilizar un Chrome/Chromium ya instalado.
# PUPPETEER_EXECUTABLE_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Opcional: emparejamiento por código en lugar de QR. Formato internacional, solo dígitos.
# Ejemplo Guatemala: 50255555555
PAIRING_NUMBER=

# Opcional: enviar el menú al administrador cuando el bot quede listo.
ADMIN_NUMBER=

# Seguridad de prueba
RESPOND_TO_GROUPS=false
# Lista separada por comas. Vacío permite cualquier chat privado.
ALLOWED_NUMBERS=

# Límites
INACTIVITY_MINUTES=10
MAX_MESSAGES_PER_MINUTE=12
IGNORE_OLD_MESSAGES_SECONDS=120
RECONNECT_DELAY_SECONDS=15
MAX_RECONNECT_ATTEMPTS=10

# Registro local de conversaciones
LOG_CONVERSATIONS=true

# Texto que se muestra en la opción de contacto
SALES_CONTACT=Un asesor revisará tu solicitud y dará seguimiento por este mismo chat.
